# Server Environment
NODE_ENV=development
PORT=3000

# Database (PostgreSQL 17)
DATABASE_URL=postgresql://postgres:password@localhost:5432/flowsy?schema=public

# Authentication & JWT Secrets (Change in production!)
JWT_ACCESS_SECRET=flowsy_super_secret_access_jwt_key_min_32_chars!
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_SECRET=flowsy_super_secret_refresh_jwt_key_min_32_chars!
JWT_REFRESH_EXPIRATION=7d

# CORS configuration (comma-separated allowlist of origins, no trailing slashes or wildcards)
CORS_ORIGIN=http://localhost:3000,http://localhost:5173,http://localhost:8081

# Default Currency & Timezone
DEFAULT_CURRENCY=EGP
DEFAULT_TIMEZONE=Africa/Cairo
